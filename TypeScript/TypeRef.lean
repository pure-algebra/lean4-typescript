/-!
# TypeScript.TypeRef

First-order target type syntax. Qualified names and their arguments are separate
data, and string literals contain their unescaped values. This module neither
parses source strings nor renders them. A consumer selects and checks its own
admitted type profile; these constructors make no typing claim.
-/

namespace TypeScript

inductive TypeRef where
  | name (qualified : List String) (args : List TypeRef)
  | literal (value : String)
  | tuple (items : List TypeRef) (readonly : Bool)
  | union (members : List TypeRef)
  /-- Property name, readonly flag, and property type, in declaration order. -/
  | object (fields : List (String × Bool × TypeRef))
  | function (params : List (String × TypeRef)) (result : TypeRef)

namespace TypeRef

-- Explicit structural recursion keeps nested equality total, without the
-- partial helpers generated by the nested BEq deriving handler.
mutual
  def beq (self other : TypeRef) : Bool :=
    match self, other with
    | .name ns as, .name ms bs => ns == ms && beqList as bs
    | .literal a, .literal b => a == b
    | .tuple as ro, .tuple bs so => beqList as bs && ro == so
    | .union as, .union bs => beqList as bs
    | .object as, .object bs => beqFields as bs
    | .function as a, .function bs b => beqParams as bs && beq a b
    | _, _ => false
  termination_by structural self

  def beqList (self other : List TypeRef) : Bool :=
    match self, other with
    | [], [] => true
    | a :: as, b :: bs => beq a b && beqList as bs
    | _, _ => false
  termination_by structural self

  def beqFields (self other : List (String × Bool × TypeRef)) : Bool :=
    match self, other with
    | [], [] => true
    | a :: as, b :: bs => beqField a b && beqFields as bs
    | _, _ => false
  termination_by structural self

  def beqField (self other : String × Bool × TypeRef) : Bool :=
    self.1 == other.1 && beqFieldType self.2 other.2
  termination_by structural self

  def beqFieldType (self other : Bool × TypeRef) : Bool :=
    self.1 == other.1 && beq self.2 other.2
  termination_by structural self

  def beqParams (self other : List (String × TypeRef)) : Bool :=
    match self, other with
    | [], [] => true
    | a :: as, b :: bs => beqParam a b && beqParams as bs
    | _, _ => false
  termination_by structural self

  def beqParam (self other : String × TypeRef) : Bool :=
    self.1 == other.1 && beq self.2 other.2
  termination_by structural self
end

mutual
  theorem beq_iff (self other : TypeRef) : beq self other = true ↔ self = other := by
    cases self <;> cases other <;>
      simp [beq, beqList_iff, beqFields_iff, beqParams_iff, beq_iff]
  termination_by structural self

  theorem beqList_iff (self other : List TypeRef) :
      beqList self other = true ↔ self = other := by
    cases self <;> cases other <;> simp [beqList, beq_iff, beqList_iff]
  termination_by structural self

  theorem beqFields_iff (self other : List (String × Bool × TypeRef)) :
      beqFields self other = true ↔ self = other := by
    cases self <;> cases other <;> simp [beqFields, beqField_iff, beqFields_iff]
  termination_by structural self

  theorem beqField_iff (self other : String × Bool × TypeRef) :
      beqField self other = true ↔ self = other := by
    cases self <;> cases other <;> simp [beqField, beqFieldType_iff]
  termination_by structural self

  theorem beqFieldType_iff (self other : Bool × TypeRef) :
      beqFieldType self other = true ↔ self = other := by
    cases self <;> cases other <;> simp [beqFieldType, beq_iff]
  termination_by structural self

  theorem beqParams_iff (self other : List (String × TypeRef)) :
      beqParams self other = true ↔ self = other := by
    cases self <;> cases other <;> simp [beqParams, beqParam_iff, beqParams_iff]
  termination_by structural self

  theorem beqParam_iff (self other : String × TypeRef) :
      beqParam self other = true ↔ self = other := by
    cases self <;> cases other <;> simp [beqParam, beq_iff]
  termination_by structural self
end

theorem beq_self (self : TypeRef) : beq self self = true :=
  (beq_iff self self).mpr rfl

instance : BEq TypeRef := ⟨beq⟩

instance : LawfulBEq TypeRef where
  rfl := beq_self _
  eq_of_beq := (beq_iff _ _).mp

instance : DecidableEq TypeRef := fun a b =>
  if h : beq a b = true then isTrue ((beq_iff a b).mp h)
  else isFalse (fun same => h ((beq_iff a b).mpr same))

end TypeRef
end TypeScript
